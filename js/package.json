{
  "name": "sbmlsim-core",
  "version": "0.29.0",
  "description": "Simulate SBML models compiled to WebAssembly in browsers and Node: the JavaScript host of sbmlsim-core with its engine (CVODE, KLU), a pool of workers and the panel endpoint of sbmlsim",
  "keywords": [
    "sbml",
    "systems-biology",
    "simulation",
    "webassembly",
    "wasm",
    "cvode",
    "ode",
    "pharmacokinetics",
    "web-worker"
  ],
  "homepage": "https://matthiaskoenig.github.io/sbmlsim-core/",
  "bugs": {
    "url": "https://github.com/matthiaskoenig/sbmlsim-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthiaskoenig/sbmlsim-core.git",
    "directory": "js"
  },
  "author": "Matthias König",
  "license": "MIT AND BSD-3-Clause AND LGPL-2.1-or-later AND Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./loader.mjs",
    "./compile": "./compile.mjs",
    "./pool": "./pool.mjs",
    "./panels": "./panels.mjs",
    "./plot": "./plot.mjs",
    "./figure": "./figure.mjs",
    "./hydrate": "./hydrate.mjs",
    "./worker": "./worker.mjs",
    "./runtime/engine.wasm": "./runtime/engine.wasm",
    "./runtime/mathlib.wasm": "./runtime/mathlib.wasm",
    "./runtime/compiler.wasm": "./runtime/compiler.wasm",
    "./runtime/plot.wasm": "./runtime/plot.wasm",
    "./package.json": "./package.json"
  },
  "bin": {
    "sbmlsim-core-simulate": "simulate.mjs"
  },
  "files": [
    "loader.mjs",
    "compile.mjs",
    "pool.mjs",
    "worker.mjs",
    "panels.mjs",
    "plot.mjs",
    "figure.mjs",
    "hydrate.mjs",
    "simulate.mjs",
    "runtime/engine.wasm",
    "runtime/mathlib.wasm",
    "runtime/compiler.wasm",
    "runtime/plot.wasm",
    "runtime/THIRD_PARTY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/",
    "build": "node build.mjs",
    "prepack": "node prepack.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "linkedom": "0.18.15"
  }
}
